# ------------------------------------------------------------------------
# Official Terraform .gitignore Template
# ------------------------------------------------------------------------

# Local .terraform directories (contains provider binaries and modules)
**/.terraform/*

# .tfstate files (contains sensitive plain-text secrets and infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely to contain sensitive passwords, tokens, and keys)
*.tfvars
*.tfvars.json

# Ignore override files (used for local modifications that shouldn't be checked in)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Ignore explicit plan outputs (if you save plans locally via `terraform plan -out=...`)
*tfplan*